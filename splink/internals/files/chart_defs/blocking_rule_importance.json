{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.9.3.json",
  "width": 450,
  "height": {
    "step": 28
  },
  "title": {
    "text": "Marginal Comparisons Generated by Each Blocking Rule",
    "subtitle": "Where marginal contribution = 0, the blocking rule is not adding any pairs and can be removed"
  },
  "data": {
    "values": []
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "marginal_comparison_count",
          "as": "max_marginal_comparison_count"
        }
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "blocking_rule",
      "type": "nominal",
      "title": null,
      "axis": {
        "labelLimit": 370,
        "maxExtent": 400
      },
      "sort": []
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#4c78a8"
      },
      "encoding": {
        "x": {
          "field": "marginal_comparison_count",
          "type": "quantitative",
          "title": "Marginal Comparisons Generated",
          "scale": {
            "zero": true
          }
        },
        "tooltip": [
          {
            "field": "blocking_rule",
            "type": "nominal",
            "title": "SQL Condition"
          },
          {
            "field": "marginal_comparison_count",
            "type": "quantitative",
            "title": "Marginal Comparisons",
            "format": ","
          },
          {
            "field": "comparison_count",
            "type": "quantitative",
            "title": "Total Comparisons",
            "format": ","
          },
          {
            "field": "overlapping_comparison_count",
            "type": "quantitative",
            "title": "Overlapping Comparisons",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.marginal_comparison_count > 0 && datum.marginal_comparison_count >= datum.max_marginal_comparison_count * 0.2"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -5,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "x": {
          "field": "marginal_comparison_count",
          "type": "quantitative"
        },
        "text": {
          "field": "marginal_comparison_count",
          "type": "quantitative",
          "format": ","
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.marginal_comparison_count > 0 && datum.marginal_comparison_count < datum.max_marginal_comparison_count * 0.2"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontWeight": "bold",
        "color": "black"
      },
      "encoding": {
        "x": {
          "field": "marginal_comparison_count",
          "type": "quantitative"
        },
        "text": {
          "field": "marginal_comparison_count",
          "type": "quantitative",
          "format": ","
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.marginal_comparison_count == 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontWeight": "bold",
        "color": "black"
      },
      "encoding": {
        "x": {
          "field": "marginal_comparison_count",
          "type": "quantitative"
        },
        "text": {
          "field": "marginal_comparison_count",
          "type": "quantitative",
          "format": ","
        }
      }
    }
  ]
}